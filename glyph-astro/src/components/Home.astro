---
// Página completa del portfolio. Atiende Mimo, el blob.
import '../styles/global.css';
import { experience, labs, projects, stack } from '../data/site';

// Secciones del recorrido: alimentan el menú y la guía lateral
const sections = [
  { id: 'inicio', name: 'Inicio' },
  { id: 'proyectos', name: 'Proyectos' },
  { id: 'labs', name: 'Labs' },
  { id: 'sobre-mi', name: 'Sobre mí' },
  { id: 'tecnologias', name: 'Tecnologías' },
  { id: 'contacto', name: 'Contacto' },
];
const menu = sections.filter((section) => !['inicio', 'tecnologias'].includes(section.id));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta
      name="description"
      content="Gabriel Pérez Diez. Desarrollador frontend. Vibecoder que ejecuta y lee el diff."
    />
    <title>Gabriel Pérez Diez · Frontend</title>
    <link rel="icon" href="data:," />
    <link rel="preload" href="/fonts/instrument-serif.ttf" as="font" type="font/ttf" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <canvas id="scene" aria-hidden="true"></canvas>
    <canvas id="glyphs" aria-hidden="true"></canvas>

    <header id="top">
      <a class="brand" href="#inicio">Gabriel Pérez Diez<span aria-hidden="true">.</span></a>
      <nav aria-label="Navegación principal">
        <span class="nav-mark" aria-hidden="true"></span>
        {menu.map((section) => <a href={`#${section.id}`} data-nav={section.id}>{section.name}</a>)}
      </nav>
      <p class="clock">Mendoza <time id="clock">--:--</time></p>
    </header>

    <ol class="rail" aria-label="Secciones">
      {
        sections.map((section, index) => (
          <li>
            <a href={`#${section.id}`} data-rail={section.id}>
              <span>{section.name}</span>
              <i aria-hidden="true">0{index + 1}</i>
            </a>
          </li>
        ))
      }
    </ol>

    <main>
      <section class="panel hero" id="inicio" data-shape="summit" data-scene="cordillera" data-side="right">
        <div class="copy">
          <p class="eyebrow"><i aria-hidden="true"></i>Frontend · Mendoza, Argentina</p>
          <h1>
            <span>Vibecoder que ejecuta.</span>
            <span class="muted">Y que lee el diff.</span>
          </h1>
          <p class="intro">
            <strong>Soy Gabriel. Programo con IA a toda velocidad y sé lo que estoy pidiendo:</strong>
            diseño la arquitectura, reviso cada cambio y lo llevo a producción.
          </p>
          <p class="actions">
            <a class="button" href="#proyectos">Ver proyectos</a>
            <button type="button" class="button ghost" id="call-agent">Hablar con Mimo<span aria-hidden="true">→</span></button>
          </p>
        </div>
        <p class="hero-foot">
          <a class="scroll-hint" href="#proyectos" aria-label="Ver proyectos"><i aria-hidden="true"></i>Seguí bajando</a>
          <span class="label">«Hacelo andar» no es mi único prompt</span>
        </p>
      </section>

      <section class="panel" id="proyectos" data-shape={projects[0].shape} data-scene="flujo" data-side="left">
        <div class="copy" data-reveal>
          <p class="label"><b>01</b>Trabajo seleccionado</p>
          <ul class="projects">
            {
              projects.map((project, index) => (
                <li>
                  <button
                    type="button"
                    data-project={project.id}
                    data-project-shape={project.shape}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                  >
                    <span>0{index + 1}</span>
                    {project.name}
                  </button>
                </li>
              ))
            }
          </ul>
          <div class="project-detail" aria-live="polite">
            {
              projects.map((project, index) => (
                <article data-detail={project.id} hidden={index !== 0}>
                  <p class="story">{project.story}</p>
                  <p class="tags">{project.tags.split(' · ').map((tag) => <span>{tag}</span>)}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="panel" id="labs" data-shape="flask" data-scene="lava" data-side="right">
        <div class="copy" data-reveal>
          <p class="label"><b>02</b>Labs</p>
          <p class="lead">
            Acá las ideas vuelan: <span>experimentos, proyectos chicos y vibecodeos, publicados apenas
            funcionan.</span>
          </p>
          <div class="lab-detail" aria-live="polite">
            <p class="lab-empty">Pasá por una tarjeta para ver de qué se trata.</p>
            {
              labs.map((lab) => (
                <article data-lab-detail={lab.id} hidden>
                  <h3>{lab.name}</h3>
                  <p class="story">{lab.note}</p>
                  <p class="tags">
                    {lab.tags.split(' · ').map((tag) => <span>{tag}</span>)}
                    {lab.href && (
                      <a href={lab.href} target={lab.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
                        Abrir ↗
                      </a>
                    )}
                  </p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="panel" id="sobre-mi" data-shape="helix" data-scene="ondas" data-side="left">
        <div class="copy" data-reveal>
          <p class="label"><b>03</b>Sobre mí</p>
          <p class="lead">
            Construyo interfaces para productos, equipos y eventos. <span>Trabajo con React y TypeScript;
            cofundé Aftercode Software.</span>
          </p>
          <ul class="rows">
            {
              experience.map((item) => (
                <li>
                  <span>{item.date}</span>
                  <div>
                    <h3>{item.place}</h3>
                    <p>{item.role}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="panel compact" id="tecnologias" data-shape="braces" data-scene="lluvia" data-side="right">
        <div class="copy" data-reveal>
          <p class="label"><b>04</b>Tecnologías</p>
          <ul class="rows stack">
            {
              stack.map((group) => (
                <li>
                  <span>{group.area}</span>
                  <p class="chips">{group.items.map((item) => <span>{item}</span>)}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="panel" id="contacto" data-shape="at" data-scene="orbita" data-side="left">
        <div class="copy" data-reveal>
          <p class="label"><b>05</b>¿Hacemos algo juntos?</p>
          <a class="talk" href="mailto:gprezdiez@gmail.com">Hablemos.<span aria-hidden="true">↗</span></a>
          <p class="actions">
            <button type="button" class="button" data-copy="gprezdiez@gmail.com">gprezdiez@gmail.com<span aria-hidden="true">Copiar</span></button>
            <a class="button ghost" href="https://github.com/gabsplat" target="_blank" rel="noopener noreferrer">GitHub<span aria-hidden="true">↗</span></a>
            <a
              class="button ghost"
              href="https://www.linkedin.com/in/gabriel-p%C3%A9rez-diez/"
              target="_blank"
              rel="noopener noreferrer">LinkedIn<span aria-hidden="true">↗</span></a
            >
          </p>
        </div>
        <footer>
          <span>© {new Date().getFullYear()} Gabriel Pérez Diez</span>
          <span>Hecho en Mendoza con Astro y WebGL</span>
        </footer>
      </section>
    </main>

    <div class="orbit" id="orbit" hidden>
      {
        labs.map((lab) => (
          <a
            class="card"
            href={lab.href ?? '#labs'}
            target={lab.href?.startsWith('http') ? '_blank' : undefined}
            rel={lab.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
            data-lab={lab.id}
            data-lab-shape={lab.shape}
            draggable="false"
          >
            <img src={`/labs/${lab.id}.webp`} alt="" width="800" height="520" draggable="false" />
            <span>{lab.name}</span>
          </a>
        ))
      }
    </div>

    <aside class="agent" id="agent" data-state="idle" aria-label="Asistente de voz">
      <div id="agent-cards" class="agent-cards"></div>
      <p id="agent-say" class="agent-say" aria-live="polite"></p>
      <p id="agent-heard" class="agent-heard"></p>
      <div id="agent-panel" class="agent-panel" hidden>
        <div id="agent-tips" class="agent-tips"></div>
        <form id="agent-type" class="agent-type">
          <input type="text" maxlength="200" placeholder="O escribime" aria-label="Mensaje para Mimo" autocomplete="off" />
        </form>
      </div>
      <div class="agent-bar">
        <button type="button" id="agent-orb" class="agent-orb" aria-pressed="false" aria-label="Hablar con Mimo, el asistente del sitio">
          <span class="aurora" aria-hidden="true"></span>
          <span id="agent-blob" class="agent-blob"></span>
          <svg class="agent-mic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3Z M6 11a6 6 0 0 0 12 0 M12 17v4" /></svg>
        </button>
        <span id="agent-hint" class="agent-hint">Tocá y hablame</span>
        <button type="button" id="agent-more" class="agent-more" aria-label="Ver ejemplos de lo que podés pedir" aria-expanded="false" hidden>?</button>
      </div>
    </aside>

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
