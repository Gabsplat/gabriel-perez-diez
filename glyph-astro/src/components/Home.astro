---
// Página completa del portfolio, en el idioma que se pida.
import '../styles/global.css';
import { content, type Lang } from '../data/site';
import { copy, HOME, LANGS } from '../i18n';
import Labs from './Labs.astro';
import { STORY_COPY } from '../data/family';
import { JOURNEY_COPY } from '../data/journey';
import '../styles/story.css';

const { lang } = Astro.props as { lang: Lang };
const t = copy[lang];
const storyCopy = STORY_COPY[lang];
const SITE = 'https://gabsplat.dev';
const { experience, labs, projects, stack } = content(lang);

// Secciones del recorrido: alimentan el menú y la guía lateral
const sections = (['inicio', 'proyectos', 'labs', 'sobre-mi', 'tecnologias', 'contacto'] as const).map((id) => ({ id, name: t.sections[id] }));
// Número de dos cifras y lugar de cada proyecto en el dial, de 0 a 1
const pad = (n: number) => String(n).padStart(2, '0');
const stationAt = (index: number) => (projects.length > 1 ? index / (projects.length - 1) : 0.5);
const menu = sections.filter((section) => !['inicio', 'tecnologias'].includes(section.id));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="description" content={t.description} />
    <title>{t.title}</title>
    <link rel="canonical" href={SITE + HOME[lang]} />
    {LANGS.map((other) => <link rel="alternate" hreflang={other} href={SITE + HOME[other]} />)}
    <link rel="alternate" hreflang="x-default" href={SITE + HOME.es} />
    <!-- Vista previa al compartir el link (LinkedIn, X, WhatsApp) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="gabsplat.dev" />
    <meta property="og:url" content={SITE + HOME[lang]} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:image" content={`${SITE}/og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogAlt} />
    <meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@gabrielpdiez" />
    <meta name="twitter:image" content={`${SITE}/og.jpg`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/instrument-serif.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <canvas id="scene" aria-hidden="true"></canvas>

    <header id="top">
      <a class="brand" href="#inicio"><svg class="sol" viewBox="0 0 64 64" aria-hidden="true"><g stroke="#f6b40e" stroke-width="3" stroke-linecap="round" fill="none"><line x1="47.00" y1="32.00" x2="59.00" y2="32.00"/><polyline points="45.86,37.74 46.51,39.86 47.83,40.58 50.02,39.46 52.13,37.98 53.57,38.41 54.17,41.18"/><line x1="42.61" y1="42.61" x2="51.09" y2="51.09"/><polyline points="37.74,45.86 36.70,47.82 37.13,49.25 39.46,50.02 42.01,50.46 42.72,51.78 41.18,54.17"/><line x1="32.00" y1="47.00" x2="32.00" y2="59.00"/><polyline points="26.26,45.86 24.14,46.51 23.42,47.83 24.54,50.02 26.02,52.13 25.59,53.57 22.82,54.17"/><line x1="21.39" y1="42.61" x2="12.91" y2="51.09"/><polyline points="18.14,37.74 16.18,36.70 14.75,37.13 13.98,39.46 13.54,42.01 12.22,42.72 9.83,41.18"/><line x1="17.00" y1="32.00" x2="5.00" y2="32.00"/><polyline points="18.14,26.26 17.49,24.14 16.17,23.42 13.98,24.54 11.87,26.02 10.43,25.59 9.83,22.82"/><line x1="21.39" y1="21.39" x2="12.91" y2="12.91"/><polyline points="26.26,18.14 27.30,16.18 26.87,14.75 24.54,13.98 21.99,13.54 21.28,12.22 22.82,9.83"/><line x1="32.00" y1="17.00" x2="32.00" y2="5.00"/><polyline points="37.74,18.14 39.86,17.49 40.58,16.17 39.46,13.98 37.98,11.87 38.41,10.43 41.18,9.83"/><line x1="42.61" y1="21.39" x2="51.09" y2="12.91"/><polyline points="45.86,26.26 47.82,27.30 49.25,26.87 50.02,24.54 50.46,21.99 51.78,21.28 54.17,22.82"/></g><circle cx="32" cy="32" r="11.5" fill="#f6b40e"/></svg>Gabriel Pérez Diez<span aria-hidden="true">.</span></a>
      <nav aria-label={t.nav}>
        <span class="nav-mark" aria-hidden="true"></span>
        {menu.map((section) => <a href={`#${section.id}`} data-nav={section.id}>{section.name}</a>)}
      </nav>
      <div class="corner">
        <p class="clock">Mendoza <time id="clock">--:--</time></p>
        <a class="cv-link" href={t.cvFile} download>{t.cv}<span aria-hidden="true">↓</span></a>
        <p class="langs" aria-label={t.language}>
          {
            LANGS.map((other) => (
              <a href={HOME[other]} hreflang={other} lang={other} data-lang={other} aria-current={other === lang ? 'true' : undefined}>
                {other.toUpperCase()}
              </a>
            ))
          }
        </p>
      </div>
    </header>

    <ol class="rail" aria-label={t.rail}>
      {
        sections.map((section, index) => (
          <li>
            <a href={`#${section.id}`} data-rail={section.id}>
              <span>{section.name}</span>
              <i aria-hidden="true">0{index + 1}</i>
            </a>
          </li>
        ))
      }
    </ol>

    <main>
      <section class="panel hero" id="inicio" data-shape="scatter" data-scene="andes" data-side="right">
        <div class="copy">
          <p class="eyebrow"><i aria-hidden="true"></i>{t.hero.eyebrow}</p>
          <h1>
            <span>{t.hero.lines[0]}</span>
            <span class="muted">{t.hero.lines[1]}</span>
          </h1>
          <p class="intro">
            <strong>{t.hero.lead}</strong>
            {t.hero.intro}
          </p>
          <p class="actions">
            <a class="button" href="#proyectos">{t.hero.work}</a>
            <a class="button ghost" href="#contacto">{t.hero.talk}<span aria-hidden="true">→</span></a>
          </p>
        </div>
        <!-- La historia de Gabriel: arranca desde la montaña -->
        <button type="button" class="play-story" id="play-story"><i aria-hidden="true"></i>{JOURNEY_COPY[lang].play}</button>
        <p class="hero-foot">
          <a class="scroll-hint" href="#proyectos"><i aria-hidden="true"></i>{t.hero.scroll}</a>
          <span class="label">{t.hero.foot}</span>
        </p>
      </section>

      <section class="panel" id="proyectos" data-shape={projects[0].shape} data-scene="ciudad" data-side="left">
        <div class="copy" data-reveal>
          <p class="label">
            <span><b>01</b>{t.projects.label}</span>
            <span class="count" aria-hidden="true"><b id="project-now">01</b> / {pad(projects.length)}</span>
          </p>
          <div class="project-detail" aria-live="polite">
            {
              projects.map((project, index) => (
                <article data-detail={project.id} hidden={index !== 0}>
                  <h2 class="project-name">
                    <span class="sr-only">{project.name}</span>
                    <span aria-hidden="true" data-name={project.name}>{project.name}</span>
                  </h2>
                  <p class="meta">{project.tags}{project.year && ` · ${project.year}`}</p>
                  <p class="story">{project.story}</p>
                  {project.href && (
                    <a class="more" href={project.href} target="_blank" rel="noopener noreferrer">{t.projects.open}</a>
                  )}
                </article>
              ))
            }
          </div>
          <!-- Sintonizador: una estación por proyecto. Entran muchos sin que crezca -->
          <div class="tuner">
            <button type="button" class="tune" data-step="-1" aria-label={t.projects.prev}>←</button>
            <div
              class="dial"
              role="slider"
              tabindex="0"
              aria-label={t.projects.choose}
              aria-valuemin="1"
              aria-valuemax={projects.length}
              aria-valuenow="1"
              aria-valuetext={projects[0].name}
              style={`--needle: ${stationAt(0)}`}
            >
              {
                projects.map((project, index) => (
                  <button
                    type="button"
                    class="station"
                    tabindex="-1"
                    data-project={project.id}
                    data-project-shape={project.shape}
                    data-name={project.name}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                    style={`--at: ${stationAt(index)}`}
                  >
                    <span class="station-number">{pad(index + 1)}</span>
                    <span class="station-name">{project.name}</span>
                  </button>
                ))
              }
              <i class="needle" aria-hidden="true"></i>
            </div>
            <button type="button" class="tune" data-step="1" aria-label={t.projects.next}>→</button>
          </div>
        </div>
      </section>

      <section class="panel" id="labs" data-shape="flask" data-scene="lava" data-side="left">
        <div class="copy" data-reveal>
          <Labs labs={labs} copy={t.labs} number="02" />
        </div>
      </section>

      <section class="panel" id="sobre-mi" data-shape="helix" data-scene="vinedos" data-side="left">
        <div class="copy" data-reveal>
          <p class="label"><b>03</b>{t.about.label}</p>
          <p class="lead">{t.about.lead} <span>{t.about.leadMuted}</span></p>
          <ul class="rows">
            {
              experience.map((item) => (
                <li>
                  <span>{item.date}</span>
                  <div>
                    <h3>{item.place}</h3>
                    <p>{item.role}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="panel compact" id="tecnologias" data-shape="braces" data-scene="atomo" data-side="right">
        <div class="copy" data-reveal>
          <p class="label"><b>04</b>{t.stack}</p>
          <ul class="rows stack">
            {
              stack.map((group) => (
                <li>
                  <span>{group.area}</span>
                  <p class="chips">{group.items.map((item) => <span>{item}</span>)}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="panel" id="contacto" data-shape="at" data-scene="planeta" data-side="left">
        <div class="copy" data-reveal>
          <p class="label"><b>05</b>{t.contact.label}</p>
          <a class="talk" href="mailto:grperezdiez@gmail.com">{t.contact.talk}<span aria-hidden="true">↗</span></a>
          <p class="actions">
            <button type="button" class="button" data-copy="grperezdiez@gmail.com" data-copied={t.contact.copied}>grperezdiez@gmail.com<span aria-hidden="true">{t.contact.copy}</span></button>
            <a class="button ghost" href={t.cvFile} download>{t.cv}<span aria-hidden="true">↓</span></a>
            <a class="button ghost" href="https://github.com/gabsplat" target="_blank" rel="noopener noreferrer">GitHub<span aria-hidden="true">↗</span></a>
            <a
              class="button ghost"
              href="https://www.linkedin.com/in/gabriel-p%C3%A9rez-diez/"
              target="_blank"
              rel="noopener noreferrer">LinkedIn<span aria-hidden="true">↗</span></a
            >
          </p>
        </div>
        <footer>
          <span>© {new Date().getFullYear()} Gabriel Pérez Diez</span>
          <span>{t.contact.made}</span>
        </footer>
      </section>
    </main>

    <div class="family-story" id="story" hidden>
      <div class="story-stage" id="story-stage" aria-live="polite"></div>
      <div class="story-actions">
        <button type="button" id="story-sound" aria-pressed="true">♪ {JOURNEY_COPY[lang].sound}</button>
        <button type="button" id="story-close">{storyCopy.close} ✕</button>
      </div>
      <!-- Al terminar: volver al inicio, grande y al centro -->
      <div class="story-end" id="story-end" hidden>
        <button type="button" class="story-home" id="story-home">{storyCopy.home}<span aria-hidden="true">↑</span></button>
        <button type="button" class="story-again" id="story-replay">{storyCopy.replay} ↻</button>
      </div>
    </div>

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
