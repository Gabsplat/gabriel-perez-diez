---
// Una historia en letras: de la cordillera a la familia. No se lista ni se indexa.
import '../styles/global.css';
import '../styles/story.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="robots" content="noindex" />
    <title>My family · Gabriel Pérez Diez</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/instrument-serif.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="story-page">
    <canvas id="story" aria-hidden="true"></canvas>
    <div class="family-story"><div class="story-stage" id="stage" aria-live="polite"></div></div>
    <div class="story-end" id="end" hidden>
      <a class="story-home" href="/">{'←'} Gabriel Pérez Diez</a>
      <button type="button" class="story-again" id="replay">↻</button>
    </div>
    <a class="back" href="/">← Gabriel Pérez Diez</a>

    <style>
      .story-page {
        overflow: hidden;
        height: 100dvh;
      }

      #story {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
      }

      .replay {
        position: fixed;
        bottom: 26px;
        left: 50%;
        padding: 10px 18px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: var(--glass);
        font: 13px var(--sans);
        color: var(--soft);
        translate: -50% 0;
        cursor: pointer;
      }

      .replay:hover {
        color: var(--paper);
      }

      .back {
        position: fixed;
        top: 20px;
        left: 22px;
        font: 11px var(--mono);
        letter-spacing: 0.06em;
        color: var(--muted);
      }
    </style>

    <script>
      import { createAsciiField } from '../scripts/ascii-field';
      import { createStory } from '../scripts/story';
      import { photoText } from '../data/family';

      // La historia sola, a pantalla completa, en el idioma elegido en el sitio
      const lang = localStorage.getItem('lang') === 'en' ? 'en' : 'es';
      document.documentElement.lang = lang;
      const field = createAsciiField(document.querySelector<HTMLCanvasElement>('#story')!, { photoText: photoText(lang), cell: innerWidth < 820 ? 5 : 6 });
      const replay = document.querySelector<HTMLButtonElement>('#replay')!;
      const end = document.querySelector<HTMLElement>('#end')!;
      if (field) {
        field.bare();
        field.show('andes');
        const story = createStory({ field, stage: document.querySelector<HTMLElement>('#stage')!, lang, onEnd: () => (end.hidden = false) });
        const video = Object.assign(document.createElement('video'), { src: '/family/vivo.mp4', muted: true, loop: true, playsInline: true, preload: 'auto' });
        Promise.all([document.fonts.ready, video.play().catch(() => undefined)]).then(() => {
          field.setPhoto(video);
          story.play();
        });
        replay.addEventListener('click', () => {
          end.hidden = true;
          story.play();
        });
      }
    </script>
  </body>
</html>
