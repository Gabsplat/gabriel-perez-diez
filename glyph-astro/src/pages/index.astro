---
import '../styles/global.css';
import { experience, labs, projects, stack } from '../data/site';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#0c0c0d" />
    <meta
      name="description"
      content="Gabriel Pérez Diez. Desarrollador frontend. Vibecoder que ejecuta y lee el diff."
    />
    <title>Gabriel Pérez Diez · Frontend</title>
    <link rel="icon" href="data:," />
    <link rel="preload" href="/fonts/instrument-serif.ttf" as="font" type="font/ttf" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <canvas id="glyphs" aria-hidden="true"></canvas>

    <header>
      <a class="brand" href="#inicio">Gabriel Pérez Diez<span aria-hidden="true">.</span></a>
      <nav aria-label="Navegación principal">
        <a href="#proyectos">Proyectos</a>
        <a href="#labs">Labs</a>
        <a href="#sobre-mi">Sobre mí</a>
        <a href="#contacto">Contacto</a>
      </nav>
    </header>

    <main>
      <section class="panel hero" id="inicio" data-shape="summit" data-side="right">
        <div class="copy">
          <p class="label">Frontend · Mendoza, Argentina</p>
          <h1>
            <span>Vibecoder que ejecuta.</span>
            <span class="muted">Y que lee el diff.</span>
          </h1>
          <p class="intro">
            Soy Gabriel. Programo con IA a toda velocidad y sé lo que estoy pidiendo: diseño la
            arquitectura, reviso cada cambio y lo llevo a producción.
          </p>
          <p class="label">«HACELO ANDAR» NO ES MI ÚNICO PROMPT</p>
        </div>
        <a class="scroll-hint" href="#proyectos" aria-label="Ver proyectos">↓</a>
      </section>

      <section class="panel" id="proyectos" data-shape={projects[0].shape} data-side="left">
        <div class="copy" data-reveal>
          <p class="label">Trabajo seleccionado</p>
          <ul class="projects">
            {
              projects.map((project, index) => (
                <li>
                  <button
                    type="button"
                    data-project={project.id}
                    data-project-shape={project.shape}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                  >
                    <span>0{index + 1}</span>
                    {project.name}
                  </button>
                </li>
              ))
            }
          </ul>
          <div class="project-detail" aria-live="polite">
            {
              projects.map((project, index) => (
                <article data-detail={project.id} hidden={index !== 0}>
                  <p class="story">{project.story}</p>
                  <p class="tags">{project.tags}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="panel" id="labs" data-shape="flask" data-side="right">
        <div class="copy" data-reveal>
          <p class="label">Labs</p>
          <p class="lead">
            Acá las ideas vuelan: experimentos, proyectos chicos y vibecodeos, publicados apenas
            funcionan.
          </p>
          <div class="lab-detail" aria-live="polite">
            {
              labs.map((lab) => (
                <article data-lab-detail={lab.id} hidden>
                  <h3>{lab.name}</h3>
                  <p class="story">{lab.note}</p>
                  <p class="tags">
                    {lab.tags}
                    {lab.href && (
                      <a href={lab.href} target="_blank" rel="noopener noreferrer">
                        Abrir ↗
                      </a>
                    )}
                  </p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="panel" id="sobre-mi" data-shape="helix" data-side="left">
        <div class="copy" data-reveal>
          <p class="label">Sobre mí</p>
          <p class="lead">
            Construyo interfaces para productos, equipos y eventos. Trabajo con React y TypeScript;
            cofundé Aftercode Software.
          </p>
          <ul class="rows">
            {
              experience.map((item) => (
                <li>
                  <span>{item.date}</span>
                  <div>
                    <h3>{item.place}</h3>
                    <p>{item.role}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="panel compact" id="tecnologias" data-shape="braces" data-side="right">
        <div class="copy" data-reveal>
          <p class="label">Tecnologías</p>
          <ul class="rows stack">
            {
              stack.map((group) => (
                <li>
                  <span>{group.area}</span>
                  <p>{group.items.join(' · ')}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="panel" id="contacto" data-shape="at" data-side="left">
        <div class="copy" data-reveal>
          <p class="label">¿HACEMOS ALGO JUNTOS?</p>
          <a class="talk" href="mailto:gprezdiez@gmail.com">Hablemos.<span aria-hidden="true">↗</span></a>
          <a class="email" href="mailto:gprezdiez@gmail.com">gprezdiez@gmail.com</a>
          <p class="links">
            <a href="https://github.com/gabsplat" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            <a
              href="https://www.linkedin.com/in/gabriel-p%C3%A9rez-diez/"
              target="_blank"
              rel="noopener noreferrer">LinkedIn ↗</a
            >
          </p>
        </div>
      </section>
    </main>

    <div class="orbit" id="orbit" hidden>
      {
        labs.map((lab) => (
          <a
            class="card"
            href={lab.href ?? '#labs'}
            target={lab.href?.startsWith('http') ? '_blank' : undefined}
            rel={lab.href?.startsWith('http') ? 'noopener noreferrer' : undefined}
            data-lab={lab.id}
            data-lab-shape={lab.shape}
            draggable="false"
          >
            <img src={`/labs/${lab.id}.webp`} alt="" width="800" height="520" draggable="false" />
            <span>{lab.name}</span>
          </a>
        ))
      }
    </div>

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
