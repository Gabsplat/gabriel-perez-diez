{
  "name": "gabriel-perez-diez",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.js",
  "routes": [
    { "pattern": "gabsplat.dev", "custom_domain": true }
  ],
  // Workers AI: Whisper para transcribir la voz
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Pasan por el Worker: la API, la portada (para el idioma) y /family (para la clave);
    // el resto se sirve directo como estático
    "run_worker_first": ["/api/*", "/", "/en", "/en/", "/family", "/family/*"]
  }
}
